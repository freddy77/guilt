if [ -z "$REG_DIR" ]; then
	echo "ERROR: You cannot run tests by hand" >&2
	exit 2
fi

set -e

export PATH=$PWD/..:$PATH

# "guilt help" should use man-pages from the source directory.
export GUILT_REG_MANDIR=$REG_DIR/man

export TZ="UTC"
export TOUCH_DATE="200701010000.00"
export GIT_AUTHOR_DATE="2007-01-01 00:00:00 UTC"
export GIT_COMMITTER_DATE="2007-01-01 00:00:00 UTC"
export GIT_AUTHOR_NAME="Author Name"
export GIT_AUTHOR_EMAIL="author@email"
export GIT_COMMITTER_NAME="Commiter Name"
export GIT_COMMITTER_EMAIL="commiter@email"

# usage: die <msg>
function die
{
	echo "Error: $@" >&2
	exit 1
}

UNAME_S=`uname -s`

if [ -r "$REG_DIR/../os.$UNAME_S" ]; then
	. "$REG_DIR/../os.$UNAME_S"
else
	die "Unsupported operating system: $UNAME_S"
fi

function replace_path
{
	# The original purpose of this function was to replace the
	# current working directory with a constant string, so that
	# the output would be the same no matter which directory the
	# tests run in.
	#
	# It is now also responsible for normalizing the output of git
	# (which occasionally improves in newer versions) so that
	# tests can succeed even when using an older version of git.
	#
	# The rest of this comment documents the normalizations.
	# Unless specifically noted, we normalize the output so that
	# it matches the newest supported version of git.
	#
	# "git reset --hard" dots
	# =======================
	#
	# When you do "git reset --hard committish" git prints a
	# message about where you end up.
	#
	# * Historically: no such message was printed.
	# * 1.5.0 and newer (see 95f2fb7d9f84 in the git repo):
	#   HEAD is now at deadbeef subject line
	# * 1.5.4 (see 0e5a7faa3a90 in the git repo):
	#   HEAD is now at deadbeef... subject line
	# * 1.5.5 and newer (see 2efb3b061709 in the git repo):
	#   HEAD is now at deadbeef subject line
	#
	# We accommodate git 1.5.4 by removing the three dots when
	# resetting to the commit named "initial".
	#
	# "git checkout b" while already on b
	# ===================================
	#
	# When invoking "git checkout b" (or, more recently, "git
	# switch b") while already working on that branch, git prints
	# a message.
	#
	# * Historically:
	#   Already on branch "b"
	# * 1.5.5 and newer:
	#   Already on "b"
	# * 1.6.2 and newer:
	#   Already on 'b'
	#
	# We transform the output to the 1.5.5 format.
	#
	# "git checkout b" while working on another branch
	# ================================================
	#
	# * Historically:
	#   Switched to branch "b"
	# * 1.6.2.3 and newer (see 714fddf2fc50 in the git repo):
	#   Switched to branch 'b'
	#
	# We transform the output to the historical format.
	#
	# "this operation must be run in a work tree"
	# ===========================================
	#
	# Many git commands fail with an error message if invoked
	# outside of a work tree.
	#
	# * Historically:
	#   fatal: This operation must be run in a work tree
	# * 2.17.0 and newer:
	#   fatal: this operation must be run in a work tree

	sed -e "s,$PWD,PATH,g" \
	    -e "s,$REG_DIR/\.\./,,g" \
	    -e "s,\.\.\. initial, initial,g" \
	    -e "s,^Already on\( branch\)\? [\"']\([^\"']*\)[\"']$,Already on \"\2\",g" \
	    -e "s,^Switched to branch [\"']\([^\"']*\)[\"'],Switched to branch \"\1\",g" \
	    -e "s,This operation must be run in a work tree,this operation must be run in a work tree,"
}

# Newer dd does
#   (1.0 kB, 1.0 kiB) copied, ...
function filter_dd
{
	sed -e 's:^\([0-9]*\) bytes (\([0-9]*\.[0-9]* *.B\).*) copied.*$:\1 bytes copied:' \
		-e 's:^\([0-9]*\) bytes .*transferred.*$:\1 bytes copied:'
}

# usage: cmd <cmd>..
function cmd
{
	printf "%% %s\n" "$*"
	if ! (
		exec 3>&1
		rv=`(("$@" 2>&1; echo $? >&4) | replace_path >&3 ) 4>&1`
		exit $rv
	) ; then
		echo "% FAIL: The above command should succeed but failed."
		exit 1
	fi
}

# usage: cmd_silent <cmd>..
# Like cmd, but discard the output from the command.
function cmd_silent
{
	printf "%% %s\n" "$*" | replace_path
	if ! (
		exec 3>&1
		rv=`(("$@" 2>&1 >/dev/null; echo $? >&4) | replace_path >&3 ) 4>&1`
		exit $rv
	) ; then
		echo "% FAIL: The above command should succeed but failed."
		exit 1
	fi
}

# usage: shouldfail <cmd>..
function shouldfail
{
	printf "%% %s\n" "$*"
	if (
		exec 3>&1
		rv=`(("$@" 2>&1; echo $? >&4) | replace_path >&3 ) 4>&1`
		exit $rv
	) ; then
		echo "% FAIL: The above command should fail but succeeded."
		exit 1
	fi
}

# usage: list_files
function list_files
{
	(
		find .git/refs/patches -type f -exec dump_ref {} \; 2> /dev/null || true
		find .git/patches -exec dump_reg {} \;
	) | sort
}

function setup_git_repo
{
	# set up the repo so we have something interesting to run guilt on
	echo "abc" > def
	git add def
	git commit -s -m "initial" 2> /dev/null > /dev/null

	# The HEAD should be a specific hash.  Abort the test if it is not.
	# If we kept on executing, the test would just fail in mysterious
	# ways.
	rev=`git rev-parse HEAD`
	[ "d4850419ccc1146c7169f500725ce504b9774ed0" != "$rev" ] && \
		die "setup_git_repo HEAD check failed (HEAD: $rev)"

	# Explicitly set config that the tests rely on.
	git config log.date default
	git config log.decorate no
	git config guilt.diffstat false
	git config guilt.reusebranch false
}

function setup_guilt_repo
{
	mkdir -p .git/patches/master

	# patch to modify a file
	cp "$REG_DIR/data/modify.patch" .git/patches/master/modify

	# patch to add a new file
	cp "$REG_DIR/data/add.patch" .git/patches/master/add

	# patch to remove an existing file
	cp "$REG_DIR/data/remove.patch" .git/patches/master/remove

	# patch to change a mode
	cp "$REG_DIR/data/mode.patch" .git/patches/master/mode

	# the series file of all the things
	cp "$REG_DIR/data/series" .git/patches/master/series

	# the status file
	touch .git/patches/master/status

	touch -a -m -t "$TOUCH_DATE" .git/patches/master/modify
	touch -a -m -t "$TOUCH_DATE" .git/patches/master/add
	touch -a -m -t "$TOUCH_DATE" .git/patches/master/remove
	touch -a -m -t "$TOUCH_DATE" .git/patches/master/mode
}

function reset_git_repo
{
	git checkout master 2>&1 | \
		sed -e "s:Already on '\\(.*\\)':Already on \"\\1\":"

	git reset --hard d4850419ccc1146c7169f500725ce504b9774ed0

	rm -rf .git/patches/
}

function setup_repo
{
	setup_git_repo
	setup_guilt_repo
}
